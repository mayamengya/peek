PORT=3000
# Your ngrok https URL (no trailing slash). Used for the photo link sent to the contractor.
PUBLIC_URL=https://abc123.ngrok-free.app

VAPI_API_KEY=
# Set to true ONLY if controlAuthenticationEnabled is on for the assistant; then VAPI_API_KEY must be your PUBLIC key.
VAPI_CONTROL_AUTH=false

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Twilio sandbox number, e.g. +14155238886 (the "whatsapp:" prefix is optional)
TWILIO_WHATSAPP_FROM=+14155238886
CONTRACTOR_WHATSAPP=+15551234567

ANTHROPIC_API_KEY=
# Optional override
VISION_MODEL=claude-sonnet-5-5
